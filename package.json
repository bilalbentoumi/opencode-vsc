{
  "name": "vsc-opencode",
  "displayName": "OpenCode — AI Agent for VS Code",
  "description": "Embeds the OpenCode web UI in a VS Code side panel.",
  "version": "0.0.1",
  "publisher": "bilalbentoumi",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilalbentoumi/opencode-vsc.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:opencode-vsc-view"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-vsc",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-vsc": [
        {
          "id": "opencode-vsc-view",
          "name": "OpenCode",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode-vsc.focus",
        "title": "OpenCode: Focus Side Panel"
      },
      {
        "command": "opencode-vsc.restart",
        "title": "OpenCode: Restart Session"
      },
      {
        "command": "opencode-vsc.selectAll",
        "title": "OpenCode: Select All"
      },
      {
        "command": "opencode-vsc.undo",
        "title": "OpenCode: Undo"
      },
      {
        "command": "opencode-vsc.redo",
        "title": "OpenCode: Redo"
      }
    ],
    "keybindings": [
      {
        "command": "opencode-vsc.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "focusedView == 'opencode-vsc-view'"
      },
      {
        "command": "opencode-vsc.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == 'opencode-vsc-view'"
      },
      {
        "command": "opencode-vsc.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "focusedView == 'opencode-vsc-view'"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode-vsc.command": {
          "type": "string",
          "default": "opencode",
          "description": "Command (or full path) used to launch the OpenCode server."
        },
        "opencode-vsc.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the OpenCode server. Use 0 for the default port; if it is busy the extension retries on a free port."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "watch": "npm run build:ext -- --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}